# Backend Environment Variables Template
# Copy this file to .env and configure your environment variables.
# DO NOT commit real secrets or production keys into version control.

ENVIRONMENT=development
PORT=8000
DEBUG=True

# Authentication / JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-secret
JWT_ALGORITHM=HS256

# Google OAuth (if applicable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
