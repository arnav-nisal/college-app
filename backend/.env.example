# Backend Environment Variables Template
# Copy this file to .env and configure your environment variables.
# DO NOT commit real secrets or production keys into version control.

DATABASE_URL=postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_DOMAIN=despu.edu.in
JWT_SECRET=your-random-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
